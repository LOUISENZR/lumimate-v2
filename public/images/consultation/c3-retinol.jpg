<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F3ECE6"/>
      <stop offset="100%" stop-color="#EADCD7"/>
    </linearGradient>
    <linearGradient id="rose" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#D8B7B8"/>
      <stop offset="100%" stop-color="#8E3B46"/>
    </linearGradient>
  </defs>
  <rect width="800" height="800" fill="url(#bg)"/>
  <!-- Decorative flower / skin motif -->
  <circle cx="400" cy="400" r="180" fill="url(#rose)" opacity="0.9"/>
  <circle cx="400" cy="400" r="180" fill="none" stroke="#FAF7F2" stroke-width="2" opacity="0.5"/>
  <circle cx="400" cy="400" r="140" fill="none" stroke="#FAF7F2" stroke-width="1.5" opacity="0.4"/>
  <circle cx="400" cy="400" r="100" fill="none" stroke="#FAF7F2" stroke-width="1.5" opacity="0.4"/>
  <circle cx="400" cy="400" r="90" fill="#4D0E12" opacity="0.85"/>
  <text x="400" y="408" fill="#FAF7F2" font-family="EB Garamond, Georgia, serif" font-size="34" text-anchor="middle" font-weight="500">LumiMate</text>
  <text x="400" y="600" fill="#8E3B46" font-family="Manrope, sans-serif" font-size="16" text-anchor="middle" letter-spacing="6" font-weight="600">RITUAL ADALAH SEGALANYA</text>
</svg>
